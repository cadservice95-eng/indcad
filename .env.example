# =============================================================================
# Render CAD Hub — environment variables
# Copy to .env.local for development, or add these in your hosting dashboard
# (Vercel: Project → Settings → Environment Variables).
#
# NEVER prefix a secret with NEXT_PUBLIC_ — that would publish it to every
# visitor's browser. Only NEXT_PUBLIC_SITE_URL and the analytics IDs are public.
# =============================================================================

# ── Public site ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.rendercadhub.com
# NEXT_PUBLIC_GSC_VERIFICATION=
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_CLARITY_ID=

# ── Database (required in production) ─────────────────────────────────────────
# Any PostgreSQL 14+ (Neon, Supabase, Vercel Postgres, RDS, your own server…).
# Without it, development falls back to an embedded database in .data/pglite,
# and production refuses to start the admin.
DATABASE_URL=
# DATABASE_SSL=disable          # only for a local Postgres without TLS
# DATABASE_POOL_MAX=5           # keep low on serverless
# AUTO_MIGRATE=false            # true = run migrations at startup (prefer `npm run db:migrate`)

# ── Admin security (required) ─────────────────────────────────────────────────
# 32+ random characters. Used to encrypt the SMTP password if you store it in
# the admin. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
# The single admin account. Created on first sign-in (or with `npm run admin:create`)
# and forced to choose a new password immediately. Remove ADMIN_INITIAL_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
# ADMIN_TIMEZONE=Asia/Kolkata   # dashboard day boundaries, reference-number year, displayed times
# ADMIN_SESSION_MAX_DAYS=7
# ADMIN_SESSION_IDLE_MINUTES=480

# ── Outgoing email (SMTP via Nodemailer) ──────────────────────────────────────
# Use the SMTP details from YOUR email/hosting provider. No provider is assumed.
# These can also be entered in Admin → Settings → SMTP (values saved there win).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true                # true for port 465 (SSL/TLS), false for 587 (STARTTLS)
SMTP_USER=support@rendercadhub.com
SMTP_PASSWORD=                  # server-side only — never NEXT_PUBLIC_
SMTP_FROM_EMAIL=support@rendercadhub.com
SMTP_FROM_NAME=Render CAD Hub

# ── Incoming email (customer replies) ─────────────────────────────────────────
# Sending SMTP cannot receive mail. Choose ONE (or both):
#
# A) Read the support mailbox over IMAP (works with any provider that offers IMAP)
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=support@rendercadhub.com
# IMAP_PASSWORD=
# IMAP_MAILBOX=INBOX
#
# B) Provider webhook: POST the raw message to /api/inbound/email/ with header
#    x-inbound-secret: <this value>. Use a long random string.
# INBOUND_EMAIL_SECRET=
#
# Scheduler for the IMAP check + follow-up reminders. Call
#   GET /api/cron/inbound-email/  with  Authorization: Bearer <CRON_SECRET>
# every few minutes (Vercel Cron sends this header automatically).
# CRON_SECRET=

# ── Attachments ───────────────────────────────────────────────────────────────
# database = files live in Postgres (works everywhere, default)
# local    = files on disk under UPLOAD_DIR (self-hosted / VPS only)
# STORAGE_DRIVER=database
# UPLOAD_DIR=.data/uploads
# Total size accepted per public form submission. Keep <= 4 on Vercel (4.5 MB body limit).
# MAX_UPLOAD_TOTAL_MB=4
# Per-file limit for files you attach in replies or that arrive by email.
# MAX_ATTACHMENT_MB=20

# ── Review requests (optional) ────────────────────────────────────────────────
# BCC address from Trustpilot's free "automatic invitations by email" feature
# (Get More Reviews → Invite via email → BCC). When set, the admin's
# "Request review" button on an enquiry BCCs this address so Trustpilot also
# sends its own invite to the customer. Leave unset to just send your own
# email with the review link and no Trustpilot BCC.
# TRUSTPILOT_BCC_EMAIL=
