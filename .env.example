# Canonical site URL used for metadata, canonical tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.rendercadhub.com

# Quote/contact form delivery — point these at your email/CRM provider's
# inbound webhook (e.g. a transactional email API, Slack or Zapier webhook).
# Until set, submissions are validated but not delivered anywhere (see
# app/api/quote/route.ts and app/api/contact/route.ts).
QUOTE_NOTIFY_WEBHOOK_URL=
CONTACT_NOTIFY_WEBHOOK_URL=

# Analytics — leave blank to disable. Nothing renders unless a real ID is set.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
